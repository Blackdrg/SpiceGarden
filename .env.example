# ============================================
# SpiceGarden Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# Application
NODE_ENV=development
PORT=3001
SESSION_DURATION_DAYS=30
REFRESH_TOKEN_LENGTH=40

# Database - PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=<must replace before use>
DB_PASS=<must replace before use>
DB_NAME=spicegarden

# Database - MongoDB
MONGO_URI=mongodb://mongo:27017/spicegarden

# Database - Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - CRITICAL: Replace with strong random secret (32+ chars) in production
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_secure_random_secret_here
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET=CHANGE_ME_IN_PRODUCTION_USE_secure_random_secret_here

# CORS - comma-separated origins; production/staging examples also include direct variables for SecretLoaderService.
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Stripe - CRITICAL: Replace with live keys for real payments
# Test keys: sk_test_..., whsec_test_...
# Live keys: sk_live_..., whsec_live_...
STRIPE_SECRET_KEY=sk_test_CHANGE_ME_NOT_CONFIGURED
STRIPE_WEBHOOK_SECRET=whsec_test_CHANGE_ME_NOT_CONFIGURED
PAYMENT_PRIMARY_GATEWAY=stripe

# Razorpay - CRITICAL: Replace with live keys for INR payments (India)
# Test keys: rzp_test_..., test_...
# Live keys: rzp_live_..., live_...
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME_NOT_CONFIGURED
RAZORPAY_KEY_SECRET=test_CHANGE_ME_NOT_CONFIGURED
RAZORPAY_WEBHOOK_SECRET=test_CHANGE_ME_NOT_CONFIGURED

# Sentry - ERROR TRACKING
SENTRY_DSN=https://[key]@[host]/1
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# OpenSearch - LOG AGGREGATION
OPENSEARCH_URL=https://opensearch:9200

# Monitoring
METRICS_ENABLED=true

# Email - SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<fill from your SMTP provider>
SMTP_FROM=noreply@spicegarden.com

# SMS & FCM - CRITICAL: FCM_SERVER_KEY required for push notifications
TWILIO_ACCOUNT_SID=<fill>
TWILIO_SID=<fill>
TWILIO_AUTH_TOKEN=<fill>
TWILIO_PHONE_NUMBER=+15555555555
TWILIO_PHONE=+15555555555
FCM_SERVER_KEY=<fill FCM server key for push notifications>
FCM_SENDER_ID=<fill>

# APNs - CRITICAL: iOS PUSH NOTIFICATIONS
# Get these values from Apple Developer Portal > Keys
APNS_PRIVATE_KEY=<fill from Apple Developer Portal>
APNS_KEY_ID=<fill>
APNS_TEAM_ID=<fill>

# Wallet Configuration
WALLET_DEFAULT_CURRENCY=INR
WALLET_NOTIFICATION_THRESHOLD=100
WALLET_LOW_BALANCE_THRESHOLD=50

# External APIs - CRITICAL: Required for production features
# Google Maps - Replace with real API key for routing/ETA
GOOGLE_MAPS_API_KEY=<fill from Google Cloud Console>
SENDGRID_API_KEY=<fill from SendGrid dashboard>

# Payment Limits
PAYMENT_MAX_SINGLE_AMOUNT=10000
PAYMENT_DAILY_LIMIT_PER_USER=50000
