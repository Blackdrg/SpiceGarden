{
  "name": "@spicegarden/backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node dist/src/main.js",
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --coverageThreshold={\\\\\\\"global\\\\\\\":{\\\\\\\"branches\\\\\\\":80,\\\\\\\"functions\\\\\\\":80,\\\\\\\"lines\\\\\\\":80,\\\\\\\"statements\\\\\\\":80}}",
    "test:unit": "jest --runInBand test/order.service.spec.ts test/kitchen.service.spec.ts test/delivery.service.spec.ts",
    "test:integration": "jest --testPathPatterns=\\\".integration.\\\" --testPathIgnorePatterns=\\\"test/mongo-connection.spec.ts\\\"",
    "test:e2e": "jest --runInBand test/e2e.spec.ts test/payment-verification.e2e.spec.ts",
    "test:load": "LOAD_TEST_MODE=true k6 run test/load/10k-users.js",
    "test:load:20k": "LOAD_TEST_MODE=true k6 run test/load/20k-users.js",
    "test:load:breaking": "LOAD_TEST_MODE=true k6 run test/load/breaking-point.js",
    "test:chaos": "kubectl apply -f test/chaos/",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:mongo": "jest --testPathPatterns=\\\"mongo-connection.spec\\\" --passWithNoTests",
    "seed": "ts-node scripts/seed-local.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/db/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/db/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/db/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/db/data-source.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.27",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.0.0",
    "@sentry/node": "^10.58.0",
    "@sqltools/formatter": "^1.2.5",
    "app-root-path": "^3.1.0",
    "argon2": "^0.40.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.10.1",
    "mongodb": "7.3.0",
    "mongoose": "9.7.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "prom-client": "^15.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sha.js": "^2.4.12",
    "socket.io": "^4.7.0",
    "sql-highlight": "^6.1.0",
    "stripe": "^15.0.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/crypto-js": "^4.2.0",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^6.0.0",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "ansis": "^4.3.0",
    "crypto-js": "^4.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "k6": "^0.0.0",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
