{
  "name": "@spicegarden/customer-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "start:ci": "cross-env CI=true npx expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "jest --config jest.config.js __tests__ --runInBand",
    "test:integration": "jest --config jest.config.js __tests__ --testPathPatterns=\"integration\" --runInBand",
    "test:e2e": "jest --config jest.config.js __tests__/e2e-flow.test.* --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.14",
    "@react-navigation/stack": "^6.4.1",
    "@spicegarden/ui": "*",
    "expo": "^56.0.13",
    "expo-constants": "~56.0.18",
    "expo-haptics": "~56.0.3",
    "expo-location": "~56.0.17",
    "expo-notifications": "~56.0.17",
    "expo-status-bar": "~56.0.4",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.15.5",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.21.2",
    "expo-image": "56.0.11",
    "react-native-reanimated": "3.19.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "react-native-root-toast": "^4.0.1",
    "react-test-renderer": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "private": true
}
