{
  "name": "@spicegarden/customer-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "start:ci": "cross-env CI=true npx expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist-web",
    "build:android": "eas build --platform android --profile production --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:preview:android": "eas build --platform android --profile development --non-interactive",
    "build:preview:ios": "eas build --platform ios --profile development --non-interactive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "jest --config jest.config.js __tests__/mobile-navigation.test.js __tests__/screens/HomeScreen.test.js __tests__/screens/CartScreen.test.js --runInBand",
    "test:integration": "jest --config jest.config.js --testPathPattern=\"integration\" --runInBand",
    "test:e2e": "jest --config jest.config.js __tests__/e2e-flow.test.* --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.6",
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.14",
    "@react-navigation/stack": "^6.4.1",
    "@spicegarden/ui": "*",
    "expo": "^56.0.13",
    "expo-constants": "~56.0.18",
    "expo-haptics": "~56.0.3",
    "expo-image": "56.0.11",
    "expo-linking": "^57.0.3",
    "expo-location": "~56.0.17",
    "expo-notifications": "~56.0.17",
    "expo-router": "^57.0.7",
    "expo-status-bar": "~56.0.4",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.15.5",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "react-doctor": "^0.5.8",
    "react-native-root-toast": "^4.0.1",
    "react-test-renderer": "^19.2.7",
    "typescript": "^5.9.3"
  },
  "private": true
}
