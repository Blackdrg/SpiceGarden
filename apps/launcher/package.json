{
  "name": "spicegarden-launcher",
  "version": "1.0.0",
  "description": "Enterprise Windows Launcher for SpiceGarden Food Delivery Platform",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"npm:dev:build:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "wait-on http://localhost:3001 && electron .",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "dist": "npm run build && npx electron-builder --win --publish=never",
    "dist:installer": "npm run build && npx electron-builder --win --ia32 --publish=never",
    "dist:portable": "npm run build && npx electron-builder --win --portable --publish=never",
    "lint": "eslint .",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:all": "npm run test:unit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "systeminformation": "^5.29.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^8.2.0",
    "css-loader": "^7.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-builder-squirrel-windows": "26.8.1",
    "html-webpack-plugin": "^5.5.0",
    "jest": "^29.7.0",
    "style-loader": "^3.3.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.5"
  },
  "build": {
    "appId": "com.spicegarden.launcher",
    "productName": "SpiceGarden Launcher",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpiceGarden Launcher"
    }
  }
}
