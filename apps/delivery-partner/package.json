{
  "name": "@spicegarden/delivery-partner",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "jest --config jest.config.js --runInBand",
    "test:integration": "jest --config jest.config.js --testPathPatterns=\"integration\" --runInBand",
    "test:e2e": "jest --config jest.config.js --testPathPatterns=\"e2e\" --runInBand",
    "test:smoke": "jest --config jest.config.js --testPathPatterns=\"delivery-api.service\" --runInBand",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:smoke"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^56.0.12",
    "expo-location": "~56.0.17",
    "expo-status-bar": "~1.12.1",
    "jest": "^29.7.0",
    "react-native": "^0.85.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
