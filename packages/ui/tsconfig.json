{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react",
    "declaration": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": "."
  },
  "include": ["*.ts", "*.tsx", "*.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "__tests__", "jest.config.js", ".babelrc", "**/*.stories.tsx"]
}