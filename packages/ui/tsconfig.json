{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["jest", "node"],
    "baseUrl": "."
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts", "*.tsx", "*.stories.tsx"],
  "exclude": ["node_modules", "__tests__", "jest.config.js", ".babelrc", "**/*.stories.tsx"]
}