{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react",
    "incremental": true,
    "types": ["jest", "node"]
  },
  "include": ["*.ts", "*.tsx", "*.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "__tests__", "jest.config.js", ".babelrc", "**/*.stories.tsx"]
}