{
  "name": "spicegarden",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces dev",
    "build": "npm run --workspaces build",
    "lint": "npm run --workspaces lint",
    "test": "npm run test:unit",
    "format": "npm run --workspaces format",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "test:integration": "npm run --workspaces --if-present test:integration",
    "test:e2e": "npm run --workspaces --if-present test:e2e",
    "test:all": "npm run --workspaces --if-present test:all"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "electron": "^42.4.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "ajv": "^6.15.0",
    "eslint-scope": "^5.1.1",
    "lucide-react": "^1.20.0",
    "pretty-format": "^27.5.1",
    "sqlite3": "6.0.1",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "engine.io": "^6.6.9",
    "form-data": "^4.0.6",
    "socket.io": "^4.8.3",
    "ws": "^8.21.0",
    "next": {
      ".": "^15.5.18",
      "postcss": "^8.5.10"
    },
    "postcss": "^8.5.10",
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    },
    "@nestjs/platform-express@11.1.27": {
      "multer": "2.2.0"
    }
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
