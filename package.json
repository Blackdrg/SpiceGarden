{
  "name": "spicegarden",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,web,restaurant,admin -c blue,green,magenta,cyan \"npm run dev -w @spicegarden/backend\" \"npm run dev -w @spicegarden/customer-web\" \"npm run dev -w @spicegarden/restaurant-dashboard\" \"npm run dev -w @spicegarden/super-admin\"",
    "build": "npm run --workspaces build",
    "lint": "npm run --workspaces lint",
    "test": "npm run test:unit",
    "format": "npm run --workspaces format",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "test:integration": "npm run --workspaces --if-present test:integration",
    "test:e2e": "npm run --workspaces --if-present test:e2e",
    "test:all": "npm run --workspaces --if-present test:all",
    "verify:stack": "node infra/scripts/verify-stack.js",
    "dev:local": "run.cmd",
    "dev:local:full": "run.cmd --full",
    "dev:local:infra": "run.cmd --infra",
    "dev:local:check": "run.cmd --check",
    "dev:local:stop": "stop.cmd",
    "local": "npm run dev:local",
    "local:full": "npm run dev:local:full",
    "local:infra": "npm run dev:local:infra",
    "local:check": "npm run dev:local:check",
    "local:stop": "npm run dev:local:stop",
    "test:load": "node infra/scripts/run-load-tests.js",
    "test:load:1k": "k6 run infra/load-tests/stage-1-1k.js -e BASE_URL=http://localhost:3001",
    "test:load:5k": "k6 run infra/load-tests/stage-2-5k.js -e BASE_URL=http://localhost:3001",
    "test:load:10k": "k6 run infra/load-tests/stage-3-10k.js -e BASE_URL=http://localhost:3001",
    "test:load:20k": "k6 run infra/load-tests/stage-4-20k.js -e BASE_URL=http://localhost:3001",
    "test:load:50k": "k6 run infra/load-tests/stage-5-50k.js -e BASE_URL=http://localhost:3001",
    "test:load:100k": "k6 run infra/load-tests/stage-6-100k.js -e BASE_URL=http://localhost:3001",
    "test:load:500k": "k6 run infra/load-tests/stage-7-500k.js -e BASE_URL=http://localhost:3001",
    "test:load:1m": "k6 run infra/load-tests/stage-8-1m.js -e BASE_URL=http://localhost:3001",
    "test:load:websocker": "k6 run infra/load-tests/websocket-stress.js",
    "test:load:database": "k6 run infra/load-tests/database-stress.js",
    "test:load:payment": "k6 run infra/load-tests/payment-stress.js",
    "test:load:failure": "k6 run infra/load-tests/failure-injection.js",
    "test:load:security": "k6 run infra/load-tests/security-under-load.js",
    "test:chaos": "kubectl apply -f test/chaos/"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^6.5.3",
    "@react-navigation/native-stack": "^6.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "electron": "^42.4.0",
    "multer": "^2.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@nestjs/typeorm": "^11.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@tootallnate/once": "^2.0.0",
    "@types/aria-query": "^5.0.0",
    "@types/babel__core": "^7.20.0",
    "@types/babel__generator": "^7.6.4",
    "@types/babel__template": "^7.4.1",
    "@types/babel__traverse": "^7.20.1",
    "@types/body-parser": "^1.19.5",
    "@types/connect": "^3.4.36",
    "@types/cookie-parser": "^1.4.7",
    "@types/crypto-js": "^4.1.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-interpolate": "^3.0.2",
    "@types/debug": "^4.1.12",
    "@types/estree": "^1.0.5",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.19.5",
    "@types/fs-extra": "^11.0.2",
    "@types/hammerjs": "^2.0.41",
    "@types/http-errors": "^2.0.4",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/jest": "29.5.14",
    "@types/json-schema": "^7.0.15",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/luxon": "^3.3.1",
    "@types/ms": "^2.0.2",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.10.9",
    "@types/qs": "^6.9.15",
    "@types/range-parser": "^1.2.7",
    "@types/react-dom": "^19.2.0",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.0.0",
    "@types/semver": "^7.5.6",
    "@types/send": "^0.17.4",
    "@types/serve-static": "^1.15.4",
    "@types/validator": "^13.12.0",
    "@types/yargs": "^17.0.32",
    "@types/yargs-parser": "^21.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@typescript-eslint/scope-manager": "^8.60.0",
    "acorn-jsx": "^5.3.2",
    "ajv": "^6.15.0",
    "csstype": "^3.1.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-scope": "^5.1.1",
    "glob": "^10.5.0",
    "html-minifier-terser": "^7.2.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "lucide-react": "^1.23.0",
    "postcss-selector-parser": "^6.0.7",
    "pretty-format": "^27.5.1",
    "psl": "^1.1.33",
    "sqlite3": "6.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.6",
    "url-parse": "^1.5.10"
  },
  "overrides": {
    "engine.io": "^6.6.9",
    "form-data": "^4.0.6",
    "socket.io": "^4.8.3",
    "ws": "^8.21.0",
    "next": {
      ".": "^15.5.18",
      "postcss": "^8.5.10"
    },
    "postcss": "^8.5.10",
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    },
    "@nestjs/platform-express@11.1.27": {
      "multer": "2.2.0"
    },
    "eslint": "^8.57.0",
    "tough-cookie": "^4.1.4",
    "@types/react": "^19.2.0",
    "jest-runtime": "29.7.0",
    "jest-mock": "29.7.0",
    "jest-config": "29.7.0",
    "babel-jest": "29.7.0"
  }
}
