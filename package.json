{
  "name": "spicegarden",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces dev",
    "build": "npm run --workspaces build",
    "lint": "npm run --workspaces lint",
    "test": "npm run test:unit",
    "format": "npm run --workspaces format",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "test:integration": "npm run --workspaces --if-present test:integration",
    "test:e2e": "npm run --workspaces --if-present test:e2e",
    "test:all": "npm run --workspaces --if-present test:all",
    "verify:stack": "node infra/scripts/verify-stack.js",
    "dev:local": "run.cmd",
    "dev:local:full": "run.cmd --full",
    "dev:local:infra": "run.cmd --infra",
    "dev:local:check": "run.cmd --check",
    "dev:local:stop": "stop.cmd",
    "local": "npm run dev:local",
    "local:full": "npm run dev:local:full",
    "local:infra": "npm run dev:local:infra",
    "local:check": "npm run dev:local:check",
    "local:stop": "npm run dev:local:stop",
    "test:load": "node infra/scripts/run-load-tests.js",
    "test:load:1k": "k6 run infra/load-tests/stage-1-1k.js -e BASE_URL=http://localhost:3001",
    "test:load:5k": "k6 run infra/load-tests/stage-2-5k.js -e BASE_URL=http://localhost:3001",
    "test:load:10k": "k6 run infra/load-tests/stage-3-10k.js -e BASE_URL=http://localhost:3001",
    "test:load:20k": "k6 run infra/load-tests/stage-4-20k.js -e BASE_URL=http://localhost:3001",
    "test:load:50k": "k6 run infra/load-tests/stage-5-50k.js -e BASE_URL=http://localhost:3001",
    "test:load:100k": "k6 run infra/load-tests/stage-6-100k.js -e BASE_URL=http://localhost:3001",
    "test:load:500k": "k6 run infra/load-tests/stage-7-500k.js -e BASE_URL=http://localhost:3001",
    "test:load:1m": "k6 run infra/load-tests/stage-8-1m.js -e BASE_URL=http://localhost:3001",
    "test:load:websocker": "k6 run infra/load-tests/websocket-stress.js",
    "test:load:database": "k6 run infra/load-tests/database-stress.js",
    "test:load:payment": "k6 run infra/load-tests/payment-stress.js",
    "test:load:failure": "k6 run infra/load-tests/failure-injection.js",
    "test:load:security": "k6 run infra/load-tests/security-under-load.js",
    "test:chaos": "kubectl apply -f test/chaos/"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "electron": "^42.4.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@testing-library/dom": "^10.0.0",
    "ajv": "^6.15.0",
    "eslint-scope": "^5.1.1",
    "glob": "^10.5.0",
    "lucide-react": "^1.20.0",
    "pretty-format": "^27.5.1",
    "sqlite3": "6.0.1",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "engine.io": "^6.6.9",
    "form-data": "^4.0.6",
    "socket.io": "^4.8.3",
    "ws": "^8.21.0",
    "next": {
      ".": "^15.5.18",
      "postcss": "^8.5.10"
    },
    "postcss": "^8.5.10",
    "@nestjs/platform-express": {
      "multer": "2.2.0"
    },
    "@nestjs/platform-express@11.1.27": {
      "multer": "2.2.0"
    }
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
