# ============================================
# SpiceGarden Production Environment Configuration
# ============================================

# Application
NODE_ENV=production
PORT=3001

# Database - PostgreSQL
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASS=${DB_PASSWORD}
DB_NAME=spicegarden
DB_CONNECTION_POOL_SIZE=50
DB_CONNECTION_POOL_MAX=100
DB_CONNECTION_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_POOL_ACQUIRE_TIMEOUT=60000

# Database - MongoDB
MONGO_URI=mongodb://${MONGO_HOST}:27017/spicegarden

# Database - Redis
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_CLUSTER_MODE=true
REDIS_CLUSTER_NODES=${REDIS_CLUSTER_NODES}

# JWT - Use secrets from vault or secrets directory
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET=${ENCRYPTION_SECRET}

# Vault Integration (enable in production)
VAULT_ENABLED=true
VAULT_ADDR=${VAULT_ADDR}
VAULT_SECRET_PATH=secret/spicegarden

# CORS - backend expects CORS_ALLOWED_ORIGINS; _FILE values are also supported by SecretLoaderService.
CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}
ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}

# Payment Gateways - direct variables are validated by main.ts. _FILE references are also loaded by SecretLoaderService.
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_SECRET_KEY_FILE=secrets/production/stripe_secret_key.txt
STRIPE_WEBHOOK_SECRET_FILE=secrets/production/stripe_webhook_secret.txt
PAYMENT_PRIMARY_GATEWAY=stripe

RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}
RAZORPAY_KEY_ID_FILE=secrets/production/razorpay_key_id.txt
RAZORPAY_KEY_SECRET_FILE=secrets/production/razorpay_key_secret.txt
RAZORPAY_WEBHOOK_SECRET_FILE=secrets/production/razorpay_webhook_secret.txt

# Monitoring
METRICS_ENABLED=true
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
RATE_LIMIT_WINDOW_MS=900
RATE_LIMIT_MAX=100

# Wallet
WALLET_DEFAULT_CURRENCY=${WALLET_DEFAULT_CURRENCY}
WALLET_NOTIFICATION_THRESHOLD=${WALLET_NOTIFICATION_THRESHOLD}
WALLET_LOW_BALANCE_THRESHOLD=${WALLET_LOW_BALANCE_THRESHOLD}