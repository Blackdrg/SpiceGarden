# ============================================
# SpiceGarden Production Environment Configuration
# ============================================

# Application
NODE_ENV=production
PORT=3001
SESSION_DURATION_DAYS=30
REFRESH_TOKEN_LENGTH=40

# Database - PostgreSQL
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASS=${DB_PASSWORD}
DB_NAME=spicegarden
DB_CONNECTION_POOL_SIZE=50
DB_CONNECTION_POOL_MAX=100
DB_CONNECTION_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_POOL_ACQUIRE_TIMEOUT=60000

# Database - MongoDB
MONGO_URI=mongodb://${MONGO_HOST}:27017/spicegarden

# Database - Redis
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_CLUSTER_MODE=true
REDIS_CLUSTER_NODES=${REDIS_CLUSTER_NODES}

# JWT - Use secrets from vault or secrets directory
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRES_IN=7d
ENCRYPTION_SECRET=${ENCRYPTION_SECRET}

# Vault Integration (enable in production)
VAULT_ENABLED=true
VAULT_ADDR=${VAULT_ADDR}
VAULT_SECRET_PATH=secret/spicegarden

# CORS - backend expects CORS_ALLOWED_ORIGINS; _FILE values are also supported by SecretLoaderService.
CORS_ALLOWED_ORIGINS=${CORS_ALLOWED_ORIGINS}

# Payment Gateways - direct variables are validated by main.ts. _FILE references are also loaded by SecretLoaderService.
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_SECRET_KEY_FILE=secrets/production/stripe_secret_key.txt
STRIPE_WEBHOOK_SECRET_FILE=secrets/production/stripe_webhook_secret.txt
PAYMENT_PRIMARY_GATEWAY=stripe

RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}
RAZORPAY_KEY_ID_FILE=secrets/production/razorpay_key_id.txt
RAZORPAY_KEY_SECRET_FILE=secrets/production/razorpay_key_secret.txt
RAZORPAY_WEBHOOK_SECRET_FILE=secrets/production/razorpay_webhook_secret.txt

# Monitoring
METRICS_ENABLED=true
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
RATE_LIMIT_AUTH_OTP_WINDOW_MS=600000
RATE_LIMIT_AUTH_OTP_MAX=3
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_ORDERS_WINDOW_MS=900000
RATE_LIMIT_ORDERS_MAX=10
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_REDIS_REQUIRED=true

# Wallet
WALLET_DEFAULT_CURRENCY=${WALLET_DEFAULT_CURRENCY}
WALLET_NOTIFICATION_THRESHOLD=${WALLET_NOTIFICATION_THRESHOLD}
WALLET_LOW_BALANCE_THRESHOLD=${WALLET_LOW_BALANCE_THRESHOLD}

# Email - SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=noreply@spicegarden.com

# SMS - Twilio
TWILIO_ACCOUNT_SID=${TWILIO_ACCOUNT_SID}
TWILIO_AUTH_TOKEN=${TWILIO_AUTH_TOKEN}
TWILIO_PHONE_NUMBER=${TWILIO_PHONE_NUMBER}

# Push Notifications - Firebase Cloud Messaging
FCM_SERVER_KEY=${FCM_SERVER_KEY}
FCM_SENDER_ID=${FCM_SENDER_ID}

# Push Notifications - Apple Push Notification Service
APNS_PRIVATE_KEY=${APNS_PRIVATE_KEY}
APNS_KEY_ID=${APNS_KEY_ID}
APNS_TEAM_ID=${APNS_TEAM_ID}

# Push Notifications - Apple Push Notification Service
APNS_PRIVATE_KEY=${APNS_PRIVATE_KEY}
APNS_KEY_ID=${APNS_KEY_ID}
APNS_TEAM_ID=${APNS_TEAM_ID}
APNS_BUNDLE_ID=${APNS_BUNDLE_ID}
APNS_ENVIRONMENT=production

# OAuth - Social Login (optional if disabled)
FACEBOOK_APP_ID=${FACEBOOK_APP_ID}
FACEBOOK_APP_SECRET=${FACEBOOK_APP_SECRET}
FACEBOOK_CALLBACK_URL=${FACEBOOK_CALLBACK_URL}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_CALLBACK_URL=${GOOGLE_CALLBACK_URL}

# Payment Gateways - Additional
STRIPE_CONNECT_SECRET_KEY=${STRIPE_CONNECT_SECRET_KEY}
STRIPE_CONNECT_WEBHOOK_SECRET=${STRIPE_CONNECT_WEBHOOK_SECRET}
STRIPE_WEBHOOK_URL=${STRIPE_WEBHOOK_URL}
STRIPE_PLATFORM_FEE_PERCENT=5
RAZORPAY_PLATFORM_FEE_PERCENT=2

PAYTM_MERCHANT_ID=${PAYTM_MERCHANT_ID}
PAYTM_MERCHANT_KEY=${PAYTM_MERCHANT_KEY}
PAYTM_WEBSITE=${PAYTM_WEBSITE}
PAYTM_INDUSTRY_TYPE=${PAYTM_INDUSTRY_TYPE}
PAYTM_CHANNEL_ID=${PAYTM_CHANNEL_ID}

PHONEPE_MERCHANT_ID=${PHONEPE_MERCHANT_ID}
PHONEPE_SALT_KEY=${PHONEPE_SALT_KEY}

BHIM_UPI_ID=${BHIM_UPI_ID}
BHIM_UPI_NAME=${BHIM_UPI_NAME}

GOOGLE_PAY_MERCHANT_ID=${GOOGLE_PAY_MERCHANT_ID}
GOOGLE_PAY_MERCHANT_NAME=${GOOGLE_PAY_MERCHANT_NAME}

# Platform URL (required for Stripe Connect, webhooks)
APP_URL=${APP_URL}

# Alerting
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
PAGERDUTY_ROUTING_KEY=${PAGERDUTY_ROUTING_KEY}
ADMIN_ALERT_EMAIL=${ADMIN_ALERT_EMAIL}
ADMIN_ALERT_PHONE=${ADMIN_ALERT_PHONE}
ALERT_WEBHOOK_URL=${ALERT_WEBHOOK_URL}
ALERT_WEBHOOK_SECRET=${ALERT_WEBHOOK_SECRET}
NOTIFICATION_CHANNELS=email,push,sms

# Vault
VAULT_TOKEN=${VAULT_TOKEN}

# OpenSearch
OPENSEARCH_URL=${OPENSEARCH_URL}

# External APIs
GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}
SENDGRID_API_KEY=${SENDGRID_API_KEY}

# Frontend
FRONTEND_URL=https://spicegarden.com